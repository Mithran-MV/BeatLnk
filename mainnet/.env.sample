# Copy to .env.local and fill in your own values. Never commit real credentials:
# this file is deliberately un-ignored (see .gitignore), so anything written
# here is published.

AUTH_SECRET=""                  # generate with: npx auth secret
HMAC_SECRET_KEY=""              # generate with: openssl rand -base64 32
AUTH_URL=""                     # your ngrok URL in development, your domain in production

# Reclaim Protocol (zk-verified Spotify data)
RECLAIM_APP_ID=""
RECLAIM_APP_SECRET=""           # server-side only - see the note below
NEXT_PUBLIC_RECLAIM_PROVIDER_ID=""

# Lighthouse (encrypted IPFS/Filecoin storage)
LIGHTHOUSE_API=""

# World Mini App
NEXT_PUBLIC_APP_ID=""           # app id from the developer portal

# DataCoin contract
DATACOIN_ADDRESS=""

# NOTE: the Reclaim app secret is currently read as NEXT_PUBLIC_SECRET in
# src/app/api/generate-config/route.ts. Next.js inlines every NEXT_PUBLIC_*
# variable into the client bundle at build time, so under that name the secret
# is shipped to every visitor's browser. It is only used server-side in a route
# handler, so it does not need the prefix - renaming it to RECLAIM_APP_SECRET
# keeps it on the server.
